{
  "name": "pedritos22.github.io",
  "private": true,
  "type": "module",
  "description": "Pietro Molendys, portfolio. No build step: the site is served as-is; these scripts are for the CV generator and the tests.",
  "scripts": {
    "serve": "node tools/serve.mjs 8000",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "cv": "node tools/build-cv.mjs --pdf",
    "cv:check": "node tools/build-cv.mjs --check",
    "projects": "node tools/fetch-projects.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.49.0"
  }
}
